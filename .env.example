# Mattermost Server Configuration
MATTERMOST_URL=https://mattermost.example.com

# Provider Selection: 'api' (preferred) or 'playwright' (fallback)
MATTERMOST_PROVIDER=api

# API Authentication (Required if MATTERMOST_PROVIDER=api)
# Personal Access Token generated from Account Settings -> Security -> Personal Access Tokens
MATTERMOST_TOKEN=your_personal_access_token_here

# Optional Team Context (ID or Name/Slug)
MATTERMOST_TEAM_ID=
MATTERMOST_TEAM_NAME=

# Optional Identity Verification (Fail-fast if authenticated user does not match)
MATTERMOST_EXPECTED_USER_ID=
MATTERMOST_EXPECTED_USERNAME=

# Playwright Browser Provider Configuration (Used if MATTERMOST_PROVIDER=playwright)
MATTERMOST_BROWSER_PROFILE_DIR=./data/mattermost-browser
MATTERMOST_HEADLESS=true

# Logging Level: debug, info, warn, error
LOG_LEVEL=info
